# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and tracking links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the Vercel Cron maintenance endpoint (Authorization: Bearer <value>)
CRON_SECRET=

# Map tiles. Use a provider whose terms permit your traffic. Public OSM tiles are for light/demo use only.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional geocoding provider (Nominatim-compatible /search endpoint). Leave empty to disable address search.
GEOCODE_URL=
GEOCODE_API_KEY=
GEOCODE_USER_AGENT=REDLINK/1.0 (contact: set-your-contact)

# Optional Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Freshness policy (hours/minutes). Defaults shown.
FRESH_MINUTES=240
STALE_HOURS=24
EXCLUDE_HOURS=72
DONOR_COOLDOWN_DAYS=90
